/* Piantor key mappings adapted to Totem's 38-key physical layout. */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        caps_logic: caps_logic {
            compatible = "zmk,behavior-hold-tap";
            label = "CAPS_LOGIC";
            bindings = <&kp>, <&caps_word>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        emojis: emojis {
            compatible = "zmk,behavior-smart-modifier";
            #binding-cells = <1>;
            mac-key = <LC(LG(SPACE))>;
            windows-key = <LG(PERIOD)>;
            label = "EMOJIS";
        };

        hyper_kp: hyper_kp {
            compatible = "zmk,behavior-smart-modifier";
            #binding-cells = <1>;
            mac-key = <LA(LG(LEFT_CONTROL))>;
            windows-key = <LA(LEFT_CONTROL)>;
            label = "HYPER_KP";
        };

        hyper_mt: hyper_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&hyper_kp>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            label = "HYPER_MT";
        };

        meta_kp: meta_kp {
            compatible = "zmk,behavior-smart-modifier";
            #binding-cells = <1>;
            mac-key = <LG(LEFT_SHIFT)>;
            windows-key = <LC(LEFT_SHIFT)>;
            label = "META_KP";
        };

        meta_mt: meta_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&meta_kp>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            label = "META_MT";
        };

        os: os {
            compatible = "zmk,behavior-os-mode";
            #binding-cells = <0>;
            label = "OS";
        };

        screen_adj: screen_adj {
            compatible = "zmk,behavior-smart-modifier";
            #binding-cells = <1>;
            mac-key = <LS(LG(N5))>;
            windows-key = <LS(LG(S))>;
            label = "Screen Adj";
        };

        screen_area: screen_area {
            compatible = "zmk,behavior-smart-modifier";
            #binding-cells = <1>;
            mac-key = <LS(LG(N4))>;
            windows-key = <LA(PRINTSCREEN)>;
            label = "Screen Area";
        };

        screen_full: screen_full {
            compatible = "zmk,behavior-smart-modifier";
            #binding-cells = <1>;
            mac-key = <LS(LG(N3))>;
            windows-key = <LG(PRINTSCREEN)>;
            label = "Screen Full";
        };

        screen_lock: screen_lock {
            compatible = "zmk,behavior-smart-modifier";
            #binding-cells = <1>;
            mac-key = <LC(LG(Q))>;
            windows-key = <LG(L)>;
            label = "SCREEN_LOCK";
        };

        smart_shift: smart_shift {
            compatible = "zmk,behavior-smart-shift";
            #binding-cells = <0>;
            label = "Toggle Smart Shift";
        };

        thrm_left: thrm_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                5 6 7 8 9  15 16 17 18 19  26 27 28 29 30  32 33 34 35 36 37
            >;

            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            label = "THRM_LEFT";
        };

        thrm_right: thrm_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                0 1 2 3 4  10 11 12 13 14  21 22 23 24 25  32 33 34 35 36 37
            >;

            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            label = "THRM_RIGHT";
        };
    };

    combos {
        compatible = "zmk,combos";

        nav_layer {
            bindings = <&tog 3>;
            key-positions = <33 36>;
            layers = <0>;
        };

        sys_layer {
            bindings = <&tog 5>;
            key-positions = <34 36>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            label = "BASE";
            bindings = <
                &kp Q  &kp W               &kp E                  &kp R                  &kp T                 &kp Y            &kp U                    &kp I                    &kp O                &kp P
                &kp A  &thrm_left LCTRL S  &thrm_left LEFT_ALT D  &thrm_left LEFT_GUI F  &thrm_left GLOBE G    &kp H            &thrm_right RIGHT_GUI J  &thrm_right RIGHT_ALT K  &thrm_right RCTRL L  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z  &kp X               &kp C                  &kp V                  &kp B                 &kp N            &kp M                    &kp COMMA                &kp DOT              &kp FSLH        &kp RSHIFT
                                           &meta_mt 0 TAB         &lt 3 SPACE            &lt 4 ESC             &lt 2 BACKSPACE  &lt 1 RETURN             &hyper_mt 0 DELETE
            >;
        };

        NUMBER {
            label = "NUMBER";
            bindings = <
        &kp LBKT   &kp N7  &kp N8  &kp N9     &kp RBKT          &none  &none     &none        &none      &none
        &kp SEMI   &kp N4  &kp N5  &kp N6     &kp EQUAL         &none  &kp RGUI  &kp RALT     &kp RCTRL  &none
&trans  &kp GRAVE  &kp N1  &kp N2  &kp N3     &kp BSLH          &none  &none     &none        &none      &none  &trans
                           &kp N0  &kp MINUS  &kp LS(LA(N2))    &none  &none     &hyper_kp 0
            >;
        };

        SYMBOL {
            label = "SYMBOL";
            bindings = <
        &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE    &none  &none          &none        &none      &none
        &kp COLON       &kp DOLLAR       &kp PERCENT            &kp CARET             &kp PLUS           &none  &kp RIGHT_GUI  &kp RALT     &kp RCTRL  &none
&trans  &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN            &kp HASH              &kp PIPE           &none  &none          &none        &none      &none  &trans
                                         &kp RIGHT_PARENTHESIS  &kp UNDERSCORE        &kp LS(LA(N8))     &none  &none          &hyper_kp 0
            >;
        };

        NAVIGATION {
            label = "NAVIGATION";
            bindings = <
        &kp LG(BACKSPACE)  &kp LA(BACKSPACE)  &none         &key_repeat   &none            &none          &none       &kp INS             &none      &none
        &none              &kp LCTRL          &kp LEFT_ALT  &kp LEFT_GUI  &kp GLOBE        &kp LEFT       &kp DOWN    &kp UP_ARROW        &kp RIGHT  &none
&trans  &kp LG(Z)          &kp LG(X)          &kp LG(C)     &kp LG(V)     &kp LS(LG(Z))    &kp HOME       &kp PG_DN   &kp PG_UP           &kp END    &none  &trans
                                              &none         &none         &to 0            &kp BACKSPACE  &kp RETURN  &hyper_mt 0 DELETE
            >;
        };

        FUNCTION {
            label = "FUNCTION";
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &screen_full 0    &none            &kp C_BRI_DN                &kp C_BRI_UP                  &screen_lock 0            &none
        &kp F11  &kp F4  &kp F5  &kp F6  &screen_area 0    &none            &thrm_right RIGHT_GUI C_PP  &thrm_right RIGHT_ALT C_PREV  &thrm_right RCTRL C_NEXT  &none
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &screen_adj 0     &none            &kp C_MUTE                  &kp C_VOL_DN                  &kp C_VOL_UP              &none  &trans
                         &none   &none   &none             &kp C_AC_SEARCH  &caps_logic CAPS 0          &emojis 0
            >;
        };

        SYSTEM {
            label = "SYSTEM";
            bindings = <
       &bootloader     &os           &smart_shift  &out OUT_TOG  &none    &none  &none  &none  &none  &bootloader
       &studio_unlock  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &none    &none  &none  &none  &none  &none
&none  &sys_reset      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none    &none  &none  &none  &none  &sys_reset   &none
                                     &none         &none         &to 0    &none  &none  &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
